<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Prana.Mobile.Features.Home"
             x:Class="Prana.Mobile.Features.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Prana">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource SpaceM}" Spacing="{StaticResource SpaceM}">

            <Label Text="Know what is in your food"
                   Style="{StaticResource Title}"
                   Margin="{StaticResource GapTopM}" />

            <Label Text="Scan a packet to see its nutrition and ingredients. Works without internet once the catalogue is installed."
                   Style="{StaticResource Muted}" />

            <Button Text="Scan a product"
                    Command="{Binding ScanCommand}"
                    SemanticProperties.Hint="Opens the camera to scan a barcode"
                    Margin="{StaticResource GapTopS}" />

            <Button Text="Search the catalogue"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SearchCommand}" />

            <Button Text="My grocery list"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding GroceryCommand}" />

            <!--
                The catalogue state is shown on the home screen on purpose. A user who does not
                know whether they have data cannot tell a missing product from a missing
                catalogue, and would blame the app for the wrong thing.
            -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTopM}">
                <VerticalStackLayout Spacing="{StaticResource SpaceXS}">
                    <Label Text="Catalogue" Style="{StaticResource Heading}" />
                    <Label Text="{Binding CatalogueStatus}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                    <Label Text="Recent scans" Style="{StaticResource Heading}" />

                    <Label Text="Nothing scanned yet. Products you look at will appear here."
                           Style="{StaticResource Muted}"
                           IsVisible="{Binding HasRecentScans, Converter={StaticResource Not}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentScans}"
                                         Spacing="{StaticResource SpaceS}"
                                         IsVisible="{Binding HasRecentScans}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentScan">
                                <VerticalStackLayout Spacing="0">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenRecentCommand}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Label}" />
                                    <!--
                                        Misses are shown, not hidden. They are what tells the
                                        project which products people actually want, and someone
                                        seeing their own miss listed understands why contributing
                                        it matters.
                                    -->
                                    <Label Text="Not in the catalogue"
                                           Style="{StaticResource Muted}"
                                           IsVisible="{Binding Found, Converter={StaticResource Not}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
