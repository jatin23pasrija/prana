<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Prana.Mobile.Features.Scanner"
             x:Class="Prana.Mobile.Features.Scanner.ScanPage"
             x:DataType="vm:ScanViewModel"
             Title="Scan">

    <Grid RowDefinitions="*,Auto">

        <!-- The camera. Replaced wholesale by a different decoder flavour if ever needed. -->
        <Grid Grid.Row="0" IsVisible="{Binding IsCameraRunning}">
            <vm:BarcodeScannerView x:Name="Scanner" />

            <Button Text="Torch"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ToggleTorchCommand}"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="{StaticResource GapTopM}"
                    SemanticProperties.Hint="Turns the camera light on or off" />
        </Grid>

        <!-- Shown when the camera was refused. Not a dead end: manual entry is right below. -->
        <VerticalStackLayout Grid.Row="0"
                             IsVisible="{Binding IsCameraRunning, Converter={StaticResource Not}}"
                             VerticalOptions="Center"
                             Padding="{StaticResource SpaceM}"
                             Spacing="{StaticResource SpaceS}">
            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
            <Button Text="Open settings"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenSettingsCommand}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Padding="{StaticResource SpaceM}"
                             Spacing="{StaticResource SpaceS}">

            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource Muted}"
                   IsVisible="{Binding IsCameraRunning}" />

            <Label Text="Or enter the barcode" Style="{StaticResource Heading}" />

            <Entry Text="{Binding Barcode}"
                   Keyboard="Numeric"
                   Placeholder="8901234567890"
                   SemanticProperties.Hint="Type the number printed under the barcode" />

            <Label Text="{Binding ValidationMessage}" Style="{StaticResource Muted}" />

            <Button Text="Look up" Command="{Binding LookUpCommand}" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
