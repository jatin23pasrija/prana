<Project>

  <!--
    Central package management. Versions are declared here once and referenced without a
    version everywhere else, so the app, the tools and the tests can never drift onto
    different versions of the same library.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON Schema validation. Used by the F02 schema tests and by the F03 validator. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!-- Catalogue storage on both the builder and the phone. See ADR-0008. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="App">
    <!-- Must match the installed MAUI workload. dotnet reports it as BundledVersions 10.0.0. -->
    <!--
      Explicitly newer than the version the workload pins. 10.0.0 crashes on every app exit with
      an ObjectDisposedException from ShellFragmentContainer.OnDestroy, which shows the user an
      "app keeps stopping" dialog each time they press Back out of the app.
    -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
