<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore uses nuget.org and nothing else. Clearing inherited sources first means a package
    source configured on a contributor machine, or on a build agent, cannot change what this
    repository restores. Builds should not depend on who is running them.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
