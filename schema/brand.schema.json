{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prana.app/schema/brand.schema.json",
  "title": "Prana brand",
  "description": "A brand as printed on packaging, stored at data/brands/<id>.json. Brands are separate records so that a rename or an ownership change is one edit rather than thousands.",

  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "$ref": "https://prana.app/schema/common.schema.json#/$defs/Slug" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "names": { "$ref": "https://prana.app/schema/common.schema.json#/$defs/LocalizedText" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "description": "Other spellings seen on real packaging."
    },
    "owner": {
      "type": "string",
      "maxLength": 150,
      "description": "The company that owns the brand, when known. Recorded for transparency, never used to rank a product."
    },
    "countries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://prana.app/schema/common.schema.json#/$defs/CountryCode" }
    },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://prana.app/schema/common.schema.json#/$defs/Source" }
    },
    "provenance": { "$ref": "https://prana.app/schema/common.schema.json#/$defs/Provenance" }
  },
  "required": ["schema_version", "id", "name", "sources", "provenance"],
  "additionalProperties": false
}
