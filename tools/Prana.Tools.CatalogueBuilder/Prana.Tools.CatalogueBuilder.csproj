<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Turns the repository into the SQLite catalogue a phone installs. The output is a published
    release artefact with a documented schema, so third parties can build their own clients
    without using this app at all.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Prana.Tools.CatalogueBuilder</RootNamespace>
    <AssemblyName>prana-catalogue</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prana.Core\Prana.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prana.Tools.CatalogueBuilder.Tests" />
  </ItemGroup>

</Project>
