<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The gate that keeps bad data out of main. Runs in CI on every data change, and locally
    before a contributor pushes.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Prana.Tools.Validator</RootNamespace>
    <AssemblyName>prana-validate</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prana.Core\Prana.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prana.Tools.Validator.Tests" />
  </ItemGroup>

</Project>
